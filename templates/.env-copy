OLLAMA_MODEL=your_chosen_model
OLLAMA_BASE_URL=http://localhost:11434

# HTTP API (app.server) — bind 0.0.0.0 so Tailscale / LAN clients can connect
API_HOST=0.0.0.0
API_PORT=8765
# Optional: path for chat session history (default sessions.sqlite in cwd)
# SESSIONS_DB_PATH=sessions.sqlite
# Max raw WAV bytes for POST /sessions/{id}/voice/wav
# VOICE_MAX_BYTES=26214400